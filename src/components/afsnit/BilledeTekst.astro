---
interface Props {
  title: string;
  paragraphs: string[];
  image: string;
  imageAlt: string;

  // Valgfri billedtekst under billedet
  caption?: string;

  // Valgfri ekstra styling til billedet
  imageClass?: string;

  // Valgfri ekstra styling til figure-elementet
  figureClass?: string;

  // Valgfri ekstra styling til tekstområdet
  textClass?: string;

  // Gør det muligt at bytte rækkefølgen på mobil
  reverseMobil?: boolean;

  // Gør det muligt at vælge heading-niveau
  headingTag?: "h1" | "h2" | "h3";
}

const { title, paragraphs, image, imageAlt, caption, imageClass, figureClass, textClass, headingTag, reverseMobil = false } = Astro.props;

// ternary operator
// hvis reversemobil er true, så ændre rækkefølgen
const figureOrder = reverseMobil ? "order-2 lg:order-1" : "order-1";
const textOrder = reverseMobil ? "order-1 lg:order-2" : "order-2";
---

<section class='mx-auto max-w-230 gap-3 px-4 py-10' data-aos='fade-left' data-aos-duration='500'>
  <div class='mx-auto grid max-w-5xl grid-cols-1 items-start gap-10 lg:grid-cols-2'>
    <!-- Billede -->
    <figure class={`${figureOrder} ${figureClass || "w-full"}`}>
      <img src={image} alt={imageAlt} class={`${imageClass || "w-full"} rounded-md object-cover`} />
      <!-- Billedtekst vises kun hvis caption findes -->
      {caption && <figcaption class='font-body text-m-p-small text-secondary lg:text-p-small mt-2 text-right'>{caption}</figcaption>}
    </figure>

    <!-- Tekst -->
    <div class={`${textOrder} ${textClass || ""}`}>
      <!-- H1 vises kun hvis headingTag er sat til h1 -->
      {headingTag === "h1" && <h1 class='font-body text-m-title1 lg:text-title1 leading-tight font-semibold'>{title}</h1>}

      <!-- H2 er standard hvis ingen headingTag er valgt -->
      {(!headingTag || headingTag === "h2") && <h2 class='font-body text-m-title2 lg:text-title2 mb-2 leading-tight font-semibold'>{title}</h2>}

      <!-- H3 vises kun hvis headingTag er sat til h3 -->
      {headingTag === "h3" && <h3 class='font-body text-m-title3 lg:text-title3 leading-tight font-semibold'>{title}</h3>}

      <!-- Wrapper til alle tekst-paragraffer -->
      <div class='font-body text-m-p-big text-secondary lg:text-p-big space-y-5 leading-relaxed'>
        <!-- Looper gennem paragraphs-arrayet og renderer hvert afsnit -->
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
