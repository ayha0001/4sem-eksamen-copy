---
import Layout from "../layouts/Layout.astro";
import TekstCenter from "../components/afsnit/TekstCenter.astro";
import TaellerSektion from "../components/forside/TaellerSektion.astro";
import MissionSektion from "../components/forside/MissionSektion.astro";
import DelerStreg from "../components/generelt/DelerStreg.astro";
import FooterMedlem from "../components/generelt/FooterMedlem.astro";
import DelerCitat from "../components/forside/DelerCitat.astro";
import ProjektSektion from "../components/afsnit/ProjektSektion.astro";
import Deler from "../components/generelt/Deler.astro";
import UdtaelseSektion2 from "../components/forside/UdtaelseSektion2.astro";
import FormHero from "../components/forside/FormHero.astro";
import HDNBanner from "../components/generelt/HDNBanner.astro";
import Knap from "../components/generelt/Knap.astro";
import MotionGraphics from "../components/forside/MotionGraphics.astro";
---

<Layout
  pagetitle='Forside'
  description='Hjælp Din Næste hjælper hjemløse og udsatte gennem uddelinger, frivillighed, gennemsigtighed og konkrete projekter, du kan støtte.'
>
  <FormHero />
  <HDNBanner backgroundColor='bg-primary' textColor='text-background1' />

  <Deler ws='m' />

  <section data-aos='fade-up' data-aos-duration='500'>
    <TekstCenter
      logo='/assets/grafik/hænder-logo.svg'
      logoAlt='Hjælp Din Næste logo med hænder'
      titel='Hvad har vi opnået i 2025?'
      tekst='Som medlem deltager du aktivt i vores kamp for at hjælpe gadens folk. Du sørger for at folk på gaden får varmt tøj, værnemidler, soveposer og andre redskaber mod kulden. Du bliver en hjemløseven og en del af vores vision for at hæve levestandarden og livskvaliteten for alle dem der lever på gaden.'
    />
    <TaellerSektion />
  </section>
  <Deler ws='m' />
  <DelerCitat
    quote='Dette er første gang i årevis, at jeg ikke føler mig hjemløs. Tusind tak for det. Jeg elsker jer alle sammen!'
    source='Citat fra tidligere hjemløs'
  />
  <Deler ws='m' />
  <section data-aos='fade-up' data-aos-duration='500'>
    <TekstCenter
      titel='Vores mission'
      tekst='Vi arbejder for at være en af verdens mest gennemsigtige NGO’er, hvor du altid kan se, hvem du hjælper.
Vi deler kvitteringer og indblik i vores arbejde på sociale medier, så din støtte er synlig og konkret.
Fra uddeling af soveposer til julehjælp viser vi præcis, hvordan dine donationer gør en forskel.'
    />
    <MissionSektion />

    <Deler ws='xs' />
    <div class='text-center'>
      <Knap variant='secondary' size='medium' href='/hvem-er-vi'> LÆS MERE OM OS </Knap>
    </div>
  </section>
  <Deler ws='m' />
  <DelerStreg src='/assets/grafik/divider_red.svg' />
  <Deler ws='m' />
  <section data-aos='fade-up' data-aos-duration='500'>
    <MotionGraphics />
  </section>
  <Deler ws='m' />
  <DelerStreg src='/assets/grafik/divider_grey.svg' />
  <Deler ws='m' />
  <ProjektSektion columns={4} />
  <Deler ws='m' />
  <UdtaelseSektion2 />
  <Deler ws='xs' />
  <div class='text-center'>
    <Knap variant='secondary' size='medium' href='/udtalelser'> Læs flere udtalelser </Knap>
  </div>
  <Deler ws='m' />
  <FooterMedlem />
</Layout>
