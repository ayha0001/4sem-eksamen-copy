---
import Taeller from "../forside/Taeller.astro";
import Deler from "../generelt/Deler.astro";
---

<section class='mx-auto max-w-235 px-4'>
  <h2 class='font-body text-m-title2 text-secondary lg:text-title2 text-center font-semibold'>I 2025 har vi</h2>
  <Deler ws='xs' />
  <div class='grid grid-cols-2 gap-6 md:grid-cols-4'>
    <Taeller
      tekst1='Omfordelt soveposer for'
      billede='/assets/grafik/sovepose.svg'
      imageAlt='En håndtegnet sovepose'
      nummer={586143}
      tekst2='kroner'
      data-aos='zoom-in'
    />
    <Taeller
      tekst1='Omfordelt tøj for'
      billede='/assets/grafik/tshirt.svg'
      imageAlt='En håndtegnet t-shirt'
      nummer={384822}
      tekst2='kroner'
      data-aos='zoom-in'
    />
    <Taeller
      tekst1='Omfordelt mad for'
      billede='/assets/grafik/bestik.svg'
      imageAlt='Håndtegnet kniv og gaffel'
      nummer={510190}
      tekst2='kroner'
      data-aos='zoom-in'
    />
    <Taeller
      tekst1='Omfordelt møbler for'
      billede='/assets/grafik/stol.svg'
      imageAlt='En håndtegnet stol'
      nummer={140464}
      tekst2='kroner'
      data-aos='zoom-in'
    />
  </div>
</section>
