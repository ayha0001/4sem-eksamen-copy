---
import Layout from "../layouts/Layout.astro";
import HeroLille from "../components/generelt/HeroLille.astro";
import Oplysninger from "../components/stoet-form/Oplysninger.astro";
import Deler from "../components/generelt/Deler.astro";
---

<Layout
  pagetitle="Oplysninger"
  description="Udfyld dine oplysninger for at støtte Hjælp Din Næste og komme videre til betaling."
>
  <section class="min-h-screen p-4 lg:p-8">
    <HeroLille titel="STØT OS" baggrund="bg-background1" farve="text-primary" />

    <Oplysninger currentStep={2} />

    <Deler ws="m" />
  </section>
</Layout>
