---
// Astro-komponent til en slider med dragbar SVG i midten
---

<style>
  /* Wrapper omkring hele slideren */
  .slider-container {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  /* Fælles styling for begge billeder */
  .slider-image {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    height: 100%;
    transition: width 0.3s ease;
    overflow: hidden;
  }

  /* Sørger for at billederne fylder hele området */
  .slider-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dragbaren i midten */
  .slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 20px;
    height: 100%;
    background: url("/public/assets/grafik/pind.svg") no-repeat center;
    background-size: contain;
    cursor: ew-resize;
    transform: translateX(-50%);
  }
</style>

<div class='slider-container'>
  <!-- Venstre billede -->
  <div class='slider-image' id='left-image'>
    <img src='/public/assets/img/nyt-hjem-1.jpg' alt='Venstre billede' />
  </div>
  <!-- Højre billede -->
  <div class='slider-image' id='right-image' style='right: 0;'>
    <img src='/public/assets/img/nyt-hjem-2.jpg' alt='Højre billede' />
  </div>
  <!-- Dragbar -->
  <div class='slider-handle' id='slider-handle'></div>
</div>

<script>
  // henter de elementer der indgår i før/efter-slideren
  const sliderHandle = document.getElementById("slider-handle");
  const leftImage = document.getElementById("left-image");
  const rightImage = document.getElementById("right-image");
  const sliderContainer = document.querySelector(".slider-container");

  // sikrer at elementerne findes før scriptet kører
  if (sliderHandle && leftImage && rightImage && sliderContainer) {
    
    // holder styr på om brugeren trækker i slideren
    let isDragging = false;

    // aktiverer slideren når brugeren klikker på håndtaget
    sliderHandle.addEventListener("mousedown", () => {
      isDragging = true;
    });

    // stopper trækket når museknappen slippes
    window.addEventListener("mouseup", () => {
      isDragging = false;
    });

    // opdaterer sliderens position mens brugeren trækker
    window.addEventListener("mousemove", (e) => {
      
      // stopper funktionen hvis slideren ikke trækkes
      if (!isDragging) return;

      // finder sliderens placering og størrelse på siden
      const rect = sliderContainer.getBoundingClientRect();

      // beregner musens position inde i slideren
      const offsetX = e.clientX - rect.left;

      // omregner positionen til en procentværdi mellem 0 og 100
      const percentage = Math.max(
        0,
        Math.min(100, (offsetX / rect.width) * 100)
      );

      // justerer bredden på billederne så sammenligningen opdateres
      leftImage.style.width = `${percentage}%`;
      rightImage.style.width = `${100 - percentage}%`;

      // flytter håndtaget til den aktuelle position
      sliderHandle.style.left = `${percentage}%`;
    });
  }
</script>