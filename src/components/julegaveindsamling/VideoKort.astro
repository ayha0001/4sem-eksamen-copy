<section class='mx-auto max-w-230 px-4'>
  <!-- Wrapper der holder videoens 16:9 format -->
  <div class='relative w-full overflow-hidden rounded-sm pb-[56.25%]'>
    <!-- Embed for en facebook-video -->
    <!-- Style fjerner standard iframe border -->
    <!-- allowfullscreen gør fullscreen muligt -->
    <!-- allow tillader video-funktioner -->
    <iframe
      class='absolute inset-0 h-full w-full'
      src='https://www.facebook.com/plugins/video.php?href=https://www.facebook.com/watch/?v=393005782490861&show_text=false'
      style='border:none;overflow:hidden'
      allowfullscreen='true'
      allow='autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share'></iframe>
  </div>
</section>
